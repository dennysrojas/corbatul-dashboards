  "decision_stories": [
    {
      "year": 2026,
      "periodIndex": 1,
      "title": "Shock Inicial y Reajuste Operativo",
      "strategicTheme": "Penalización por falta de decisión oportuna y erosión de márgenes en calcetines",
      "initialState": {
        "companyValue": 2329.3,
        "cash": 1916796,
        "totalRevenue": 3346747,
        "diagnosticContext": "Roura1940 arranca el ejercicio con alta liquidez heredada de 2025 (1.9M€), pero con una ineficiencia estructural severa en la línea de calcetines donde el coste de fabricación superaba el precio de lista ($2.65).",
        "criticalChallenge": "Reaccionar a la caída abrupta de demanda tras una omisión en la introducción de decisiones iniciales que provocó un castigo algorítmico del 5% ('No Decisión' = 0.95)."
      },
      "decisions": {
        "prices": "Corbatas: 17.00€ | Bufandas: 27.90€ | Calcetines: 2.99€",
        "operations": "Producción recortada a 174.6k uds para drenar existencias previas.",
        "rationale": "Mantener calidad en proveedores (Premium en corbatas, Estándar en bufandas) pero frenar el desangre de calcetines ajustando el precio a 2.99€."
      },
      "consequences": {
        "companyValue": 1832.7,
        "netIncome": -859512,
        "verdict": "El Valor de Compañía se desplomó a 1.832,7 puntos (puesto 6 de 7). La empresa sufrió una pérdida neta de 859k€ debido al impacto de costes fijos y gastos de estructura sobre una base de ingresos reducida a 2.55M€."
      }
    },
    {
      "year": 2027,
      "periodIndex": 2,
      "title": "Plan de Choque y Ofensiva Comercial",
      "strategicTheme": "Subida moderada de precios (+15% max), aumento de producción y rescate de márgenes",
      "initialState": {
        "companyValue": 1832.7,
        "cash": 1714753,
        "totalRevenue": 2549514,
        "diagnosticContext": "Tras el golpe de 2026, el equipo FINFORCE formaliza su Plan de Actuación ACBSP con un diagnóstico exhaustivo de DAFO y ratios de rotación.",
        "criticalChallenge": "Recuperar el volumen de ventas sin caer en guerras de precios destructivas, resolviendo la pérdida en calcetines y aprovechando la fortaleza de marca en corbatas."
      },
      "decisions": {
        "prices": "Corbatas: 17.50€ (+2.9%) | Bufandas: 28.50€ (+2.1%) | Calcetines: 3.00€ (+0.3%)",
        "operations": "Expansión masiva de producción a 259,000 unidades (200k corbatas, 29k bufandas, 30k calcetines). Descuento canal al 13%.",
        "rationale": "Diluir los elevados costes fijos de fábrica mediante economías de escala y aprovechar la cobertura de distribución (64%)."
      },
      "consequences": {
        "companyValue": 2242.7,
        "netIncome": -958687,
        "verdict": "¡Rebote extraordinario en el valor de la empresa (+410 puntos)! Los ingresos rebotaron de 2.55M€ a 3.81M€ (+49%), y el margen bruto subió del 26.9% al 36.3%. Aunque el resultado neto contable aún reflejó gastos de reestructuración, la viabilidad operativa quedó restablecida."
      }
    },
    {
      "year": 2028,
      "periodIndex": 3,
      "title": "Turnaround: Retorno a Beneficios Netos",
      "strategicTheme": "Calibración fina de precios, eficiencia en aprovisionamiento y reducción del agujero de calcetines",
      "initialState": {
        "companyValue": 2242.7,
        "cash": 477169,
        "totalRevenue": 3806940,
        "diagnosticContext": "Roura1940 ha escalado al puesto 4 de la industria, superando a RealMan, FashionClub y PuntoOne que sufrieron caídas estrepitosas por malas decisiones financieras.",
        "criticalChallenge": "Alcanzar por fin el punto de equilibrio (break-even) y cerrar la brecha con los líderes SmartOne y Spain10."
      },
      "decisions": {
        "prices": "Corbatas: 18.20€ | Bufandas: 29.60€ | Calcetines: 3.40€ (+13.3%)",
        "operations": "Producción de 267,500 uds (215k corbatas a plena capacidad). Racionalización de inventarios.",
        "rationale": "El incremento agresivo pero justificado en calcetines (a 3.40€) casi elimina el margen negativo (-6.1% vs -52.7% en 2026), mientras que las corbatas entregan un margen bruto récord del 46.7%."
      },
      "consequences": {
        "companyValue": 2596.5,
        "netIncome": 111404,
        "verdict": "¡Éxito histórico! Resultado Neto positivo de +111.404€ y Valor de Compañía ascendiendo a 2.596,5 puntos (+354 puntos). Roura1940 consolida el tercer puesto absoluto de la industria, pisándole los talones a SmartOne y Spain10."
      }
    },
    {
      "year": 2029,
      "periodIndex": 4,
      "title": "Consolidación Triunfal y Plena Rentabilidad",
      "strategicTheme": "Margen bruto cercano al 50%, calcetines rentables (+24%) y récord de ingresos",
      "initialState": {
        "companyValue": 2596.5,
        "cash": 474877,
        "totalRevenue": 4116519,
        "diagnosticContext": "La empresa llega al último periodo con telares al 94.9% de ocupación, valor de producto de 8.3/10 y cobertura comercial del 78%.",
        "criticalChallenge": "Maximizar la generación neta de caja, rentabilizar todas las 3 líneas de negocio y presentar una auditoría impecable ante la Junta y ACBSP."
      },
      "decisions": {
        "prices": "Corbatas: 18.50€ | Bufandas: 30.00€ | Calcetines: 3.50€",
        "operations": "Capacidad ampliada a 293,000 uds (+8,000 en bufandas). Producción de 278,000 unidades. Promoción de marca reforzada a 200,000€.",
        "rationale": "Aprovechar la alta disposición a pagar por la calidad Roura1940 y convertir la línea de calcetines en una fuente de beneficio genuino con margen del 24%."
      },
      "consequences": {
        "companyValue": 2879.0,
        "netIncome": 365700,
        "verdict": "Culminación brillante del plan FINFORCE. Ingresos de 4,59M€ (+11.5%), Margen bruto del 49.3% (2.26M€), Resultado Neto récord de +365.700€ y Valor de Compañía alcanzando 2.879 puntos (crecimiento acumulado de +1.046 puntos desde el suelo de 2026)."
      }
    }
